{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "scanner*.{js,css}", "use": "@vercel/static" },
    { "src": "api/scan-pair.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/scan-pair", "dest": "/api/scan-pair.js" },
    { "src": "/(scanner(?:-pair|-qr)?\\.(?:js|css))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
